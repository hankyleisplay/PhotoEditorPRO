{
  "name": "photo-editor-pro",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:secure": "node build-secure.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.4.3",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.photoeditorpro.app",
    "productName": "Photo Editor PRO",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "image_processor.wasm",
      "index.html",
      "style.css",
      "fonts/*",
      "lucide.min.js",
      "license-public.json",
      "sample.jpg",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
