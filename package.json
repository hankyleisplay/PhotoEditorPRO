{
  "name": "photo-editor-pro",
  "private": true,
  "version": "1.4.0",
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.photoeditorpro.app",
    "productName": "Photo Editor PRO",
    "publish": [
      {
        "provider": "github",
        "owner": "hankyleisplay",
        "repo": "PhotoEditorPRO"
      }
    ],
    "nsis": {
      "artifactName": "Photo-Editor-PRO-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Photo-Editor-PRO-${version}-portable.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "app.js",
      "image_processor.wasm",
      "index.html",
      "style.css",
      "liquid-glass.css",
      "fonts/*",
      "lucide.min.js",
      "sample.jpg",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
